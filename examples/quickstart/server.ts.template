import * as Domain from "@alchemy.run/domain"
import { BunHttpServer, BunRuntime } from "@effect/platform-bun"
import { ReceiptOwnerGuardLive } from "tardie/domain"
import { SessionLive } from "tardie/platform/alchemy"
import { Config, Effect, Layer } from "effect"
import { HttpServer, HttpServerRequest, HttpServerResponse } from "effect/http"
import { WorkflowEngine } from "effect/workflow"
import { CounterApi, CounterModel, CounterNotificationsLive, NotifyCountLive, notifyLayer } from "./actor"

const platform = Layer.merge(Domain.InMemory, WorkflowEngine.layerMemory)
const model = Layer.merge(CounterModel.layer(CounterNotificationsLive), ReceiptOwnerGuardLive).pipe(
  Layer.provide(NotifyCountLive.pipe(Layer.provide(notifyLayer))),
  Layer.provide(platform),
)
const server = Layer.unwrap(Effect.gen(function* () {
  const api = yield* CounterApi.pipe(Effect.provide(SessionLive))
  return HttpServer.serve(Effect.gen(function* () {
    const request = yield* HttpServerRequest.HttpServerRequest
    if (new URL(request.url, "http://localhost").pathname === "/healthz") return HttpServerResponse.text("ok")
    return yield* api.fetch
  }))
}))
server.pipe(
  Layer.provide(model),
  Layer.provide(BunHttpServer.layerConfig({ port: Config.Int("PORT") })),
  Layer.launch,
  BunRuntime.runMain,
)
