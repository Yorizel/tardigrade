{
  "name": "tardigrade",
  "version": "0.55.0",
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "workspaces": [
    "packages/domain",
    "packages/platform",
    "packages/apps/cli",
    "packages/examples",
    "packages/tardie",
    "packages/ui",
    "apps/web"
  ],
  "scripts": {
    "tdg": "bun run packages/apps/cli/src/main.ts",
    "cli:build": "bun run pack",
    "cli:check": "bun run gate --only=lint:effect:packages:apps:cli,typecheck:apps-cli,test:apps-cli",
    "gate": "bun run tools/gate.ts",
    "lint": "bun run tools/native-oxlint.ts tsrs --type-aware --max-warnings=0",
    "lint:effect": "bun run gate --only=lint:effect",
    "typecheck": "bun run gate --only=typecheck",
    "test": "bun run gate --only=test",
    "web": "bun run --cwd apps/web dev",
    "knip": "knip --no-progress --treat-config-hints-as-errors --treat-tag-hints-as-errors",
    "setup": "git config core.hooksPath .githooks",
    "pack": "bun run tools/publish.ts --dry-run",
    "chat": "bun run packages/apps/cli/src/main.ts",
    "exports": "bun run tools/public-exports.ts",
    "postinstall": "bun run exports",
    "lint:tsgo": "bun run tools/native-oxlint.ts tsgo --type-aware --max-warnings=0",
    "typecheck:tsrs": "effect-tsgo tsrs@0.21.0-ts7.1.0-beta --noEmit",
    "lint:audit": "bun run tools/native-oxlint.ts tsrs --type-aware --max-warnings=0 --config .oxlintrc.audit.json",
    "lint:effect:audit": "bun run tools/effect-lint-audit.ts"
  },
  "dependencies": {
    "@types/node": "^24",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@alchemy.run/domain": "2.0.0-beta.85",
    "@aurelienbbn/oxlint-plugin-alchemy": "0.1.1",
    "@effect/ai-openai": "4.1.2",
    "@effect/platform-bun": "4.1.2",
    "@effect/sql-sqlite-bun": "4.1.2",
    "@effect/tsgo": "0.67.3",
    "@types/aria-query": "^5.0.4",
    "@types/bun": "^1.3.4",
    "alchemy": "2.0.0-beta.85",
    "aria-query": "^5.3.2",
    "beautiful-mermaid": "^1.1.3",
    "effect": "4.1.2",
    "html-tag-names": "^2.1.0",
    "knip": "^6.15.0",
    "oxc-parser": "0.143.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005"
  },
  "private": true,
  "patchedDependencies": {
    "effect@4.1.2": "patches/effect@4.1.2.patch"
  },
  "overrides": {
    "effect": "4.1.2"
  }
}
