{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": [
    "@clavia/tardigrade-ui"
  ],
  "workspaces": {
    "packages/tardie": {
      "entry": [
        "src/generated/**/*.ts!",
        "__tests__/**/*.test.ts"
      ],
      "project": [
        "__tests__/**/*.ts"
      ]
    },
    "packages/platform": {
      "project": [
        "src/**/*.ts",
        "__tests__/**/*.ts"
      ]
    },
    "packages/examples": {
      "entry": [
        "*.ts!",
        "__tests__/**/*.test.ts"
      ],
      "project": [
        "**/*.ts"
      ]
    },
    ".": {
      "ignoreDependencies": [
        "@effect/language-service"
      ],
      "entry": [
        "tools/*.ts",
        "tools/__tests__/*.ts",
        "examples/alchemy/*.ts",
        "examples/quickstart/*.ts"
      ],
      "project": [
        "tools/**/*.ts",
        "examples/**/*.ts"
      ]
    },
    "apps/web": {
      "entry": [
        "src/**/*.{test,spec}.{ts,tsx}",
        "../../docs/**/*.mdx",
        "../../notes/**/*.mdx"
      ],
      "project": [
        "src/**/*.{ts,tsx}!",
        "../../docs/**/*.mdx",
        "../../notes/**/*.mdx"
      ]
    }
  }
}
