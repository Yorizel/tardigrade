+fn node_worker_import(identifier: &IdentifierReference<'_>, namespace: bool, port: bool, ctx: &LintContext<'_>) -> bool {
+    let Some(symbol) = ctx.scoping().get_reference(identifier.reference_id()).symbol_id() else {
+        return false;
+    };
+    let declaration = ctx.scoping().symbol_declaration(symbol);
+    let imported = match ctx.nodes().kind(declaration) {
+        AstKind::ImportSpecifier(specifier) if !namespace => {
+            if port { specifier.imported.name() == "parentPort" } else { matches!(specifier.imported.name().as_str(), "Worker" | "MessagePort" | "BroadcastChannel") }
+        }
+        AstKind::ImportNamespaceSpecifier(_) if namespace => true,
+        _ => false,
+    };
+    imported && matches!(ctx.nodes().parent_kind(declaration), AstKind::ImportDeclaration(import)
+        if import.source.value.as_str().is_some_and(|source| matches!(source, "node:worker_threads" | "worker_threads")))
+}
+
+fn node_worker_type(name: &TSTypeName<'_>, ctx: &LintContext<'_>) -> bool {
+    match name {
+        TSTypeName::IdentifierReference(identifier) => node_worker_import(identifier, false, false, ctx),
+        TSTypeName::QualifiedName(name) => {
+            matches!(name.right.name.as_str(), "Worker" | "MessagePort" | "BroadcastChannel")
+                && matches!(&name.left, TSTypeName::IdentifierReference(identifier) if node_worker_import(identifier, true, false, ctx))
+        }
+        _ => false,
+    }
+}
+
+fn is_node_worker_receiver(expr: &Expression<'_>, ctx: &LintContext<'_>) -> bool {
+    if let Some(member) = expr.without_parentheses().get_member_expr()
+        && !member.is_computed()
+        && member.static_property_name().is_some_and(|name| name == "parentPort")
+        && let Expression::Identifier(namespace) = member.object().without_parentheses()
+    {
+        return node_worker_import(namespace, true, false, ctx);
+    }
+    let Expression::Identifier(identifier) = expr.without_parentheses() else { return false };
+    if node_worker_import(identifier, false, true, ctx) {
+        return true;
+    }
+    let Some(symbol) = ctx.scoping().get_reference(identifier.reference_id()).symbol_id() else { return false };
+    if !ctx.scoping().symbol_flags(symbol).is_const_variable() {
+        return false;
+    }
+    let AstKind::VariableDeclarator(declaration) = ctx.nodes().kind(ctx.scoping().symbol_declaration(symbol)) else { return false };
+    if let Some(annotation) = &declaration.type_annotation
+        && let TSType::TSTypeReference(reference) = &annotation.type_annotation
+        && node_worker_type(&reference.type_name, ctx)
+    {
+        return true;
+    }
+    if let Some(Expression::NewExpression(new)) = &declaration.init {
+        if let Expression::Identifier(constructor) = &new.callee {
+            return node_worker_import(constructor, false, false, ctx);
+        }
+        if let Some(member) = new.callee.get_member_expr()
+            && !member.is_computed()
+            && member.static_property_name().is_some_and(|name| name == "Worker" || name == "MessagePort" || name == "BroadcastChannel")
+            && let Expression::Identifier(namespace) = member.object().without_parentheses()
+        {
+            return node_worker_import(namespace, true, false, ctx);
+        }
+    }
+    false
+}
