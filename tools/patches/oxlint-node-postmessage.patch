+#[test]
+fn test_node_worker_provenance() {
+    use crate::tester::Tester;
+    let pass = vec![
+        "import { Worker as NodeWorker } from 'node:worker_threads'; const worker = new NodeWorker('x'); worker.postMessage(1)",
+        "import { Worker as NodeWorker } from 'node:worker_threads'; const worker: NodeWorker = acquire(); worker.postMessage(1)",
+        "import * as node from 'node:worker_threads'; const worker: node.Worker = acquire(); worker.postMessage(1)",
+        "import * as node from 'node:worker_threads'; const worker = new node.Worker('x'); worker.postMessage(1)",
+        "import * as node from 'node:worker_threads'; node.parentPort?.postMessage(1)",
+        "import { parentPort as connection } from 'node:worker_threads'; connection?.postMessage(1)",
+    ];
+    let fail = vec![
+        "import { Worker } from 'node:worker_threads'; window.postMessage(1)",
+        "import { Worker as NodeWorker } from 'node:worker_threads'; function f(NodeWorker: Window) { NodeWorker.postMessage(1) }",
+        "import { Worker as NodeWorker } from 'fake'; const worker: NodeWorker = acquire(); worker.postMessage(1)",
+        "import { Worker as NodeWorker } from 'node:worker_threads'; let worker: NodeWorker = acquire(); worker.postMessage(1)",
+        "import { Worker as NodeWorker } from 'node:worker_threads'; const worker = getWindow(); worker.postMessage(1)",
+    ];
+    Tester::new(RequirePostMessageTargetOrigin::NAME, RequirePostMessageTargetOrigin::PLUGIN, pass, fail)
+        .expect_fix(vec![("window.postMessage(message)", "window.postMessage(message, window.location.origin)")])
+        .test();
+}
