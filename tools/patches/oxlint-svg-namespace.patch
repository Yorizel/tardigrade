+#[test]
+fn svg_namespace() {
+    use crate::tester::Tester;
+    let pass = vec![
+        r#"<svg role="img" />"#,
+        r#"<svg><g role="img" /></svg>"#,
+        r#"<g role="img" />"#,
+        r#"<svg><foreignObject><svg><g role="img" /></svg></foreignObject></svg>"#,
+        r#"<svg:g role="img" />"#,
+        r#"<div role={1} />"#,
+        r#"<div role={true} />"#,
+        r#"<div role={"button"} />"#,
+    ];
+    let fail = vec![
+        r#"<div role="img" />"#,
+        r#"<input role="button" />"#,
+        r#"<div role="search" />"#,
+        r#"<svg><foreignObject><div role="img" /></foreignObject></svg>"#,
+        r#"<svg><foreignObject><g role="img" /></foreignObject></svg>"#,
+        r#"<svg><Unknown role="img" /></svg>"#,
+        r#"<div role="img checkbox" />"#,
+    ];
+    Tester::new(PreferTagOverRole::NAME, PreferTagOverRole::PLUGIN, pass, fail).test();
+}
