+#[test]
+fn svg_namespace_settings() {
+    use crate::tester::Tester;
+    let settings = serde_json::json!({"settings": {"jsx-a11y": {
+        "components": {"Vector": "svg", "Group": "g", "Box": "div"},
+        "polymorphicPropName": "as"
+    }}});
+    let pass = vec![
+        (r#"<Vector role="img" />"#, None, Some(settings.clone())),
+        (r#"<Group role="img" />"#, None, Some(settings.clone())),
+        (r#"<Shape as="svg" role="img" />"#, None, Some(settings.clone())),
+    ];
+    let fail = vec![
+        (r#"<Box role="img" />"#, None, Some(settings.clone())),
+        (r#"<Vector><Box role="img" /></Vector>"#, None, Some(settings.clone())),
+        (r#"<Vector><foreignObject><Box role="img" /></foreignObject></Vector>"#, None, Some(settings)),
+    ];
+    Tester::new(PreferTagOverRole::NAME, PreferTagOverRole::PLUGIN, pass, fail).test();
+}
