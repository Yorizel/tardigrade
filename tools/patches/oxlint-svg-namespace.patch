+fn is_intrinsic_name(name: &str) -> bool {
+    HTML_TAG.contains(name)
+        || VUE_RESERVED_SVG_ELEMENTS.contains(name)
+        || name.starts_with("svg:")
+        || name.starts_with("html:")
+}
+
+fn is_svg_element<'a>(node: &AstNode<'a>, element: &JSXOpeningElement<'a>, name: &str, ctx: &LintContext<'a>) -> bool {
+    let raw_name = get_jsx_element_name(&element.name);
+    let intrinsic = is_intrinsic_name(&raw_name);
+    let tag = if intrinsic { raw_name.as_ref() } else { name };
+    if tag == "svg" || tag.starts_with("svg:") {
+        return true;
+    }
+    if (!intrinsic && HTML_TAG.contains(tag)) || tag.starts_with("html:") || !is_intrinsic_name(tag) {
+        return false;
+    }
+    let ancestors: Vec<_> = ctx.nodes().ancestors(node.id()).filter_map(|ancestor| {
+        if let AstKind::JSXElement(element) = ancestor.kind() { Some(element) } else { None }
+    }).skip(1).collect();
+    let mut svg = None;
+    for ancestor in ancestors.into_iter().rev() {
+        let raw_ancestor = get_jsx_element_name(&ancestor.opening_element.name);
+        let resolved_ancestor = get_element_type(ctx, &ancestor.opening_element);
+        let ancestor_intrinsic = is_intrinsic_name(&raw_ancestor);
+        let ancestor_name = if ancestor_intrinsic { raw_ancestor.as_ref() } else { resolved_ancestor.as_ref() };
+        if ancestor_name == "foreignObject" || ancestor_name == "svg:foreignObject" || ancestor_name.starts_with("html:") {
+            svg = Some(false);
+        } else if ancestor_name == "svg" || ancestor_name.starts_with("svg:") {
+            svg = Some(true);
+        } else if (!ancestor_intrinsic && HTML_TAG.contains(ancestor_name)) || !is_intrinsic_name(ancestor_name) {
+            svg = Some(false);
+        } else if svg.is_none() {
+            svg = Some(VUE_RESERVED_SVG_ELEMENTS.contains(ancestor_name) && !HTML_TAG.contains(ancestor_name));
+        }
+    }
+    svg.unwrap_or_else(|| VUE_RESERVED_SVG_ELEMENTS.contains(tag) && !HTML_TAG.contains(tag))
+}
