    "./platform/codemode": "./src/generated/platform/codemode.ts",
    "./domain/agents-result": "./src/generated/domain/agents-result.ts",
    "./platform/testing/story": "./src/generated/platform/testing/story.ts",
    "./platform/testing/scene": "./src/generated/platform/testing/scene.ts"
  },
  "dependencies": {
    "@clavia/tardigrade-domain": "workspace:*",
    "@clavia/tardigrade-platform": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1"
